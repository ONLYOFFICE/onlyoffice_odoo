<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
<t t-name="onlyoffice_odoo_templates.FormGalleryDialog" owl="1">
    <Dialog title="title" size="'xl'" footer="true">
      <div class="container-fluid">
        <div class="row mb-3" t-if="!state.loading and !state.error and state.total > state.limit">
          <div class="col text-center o-pager">
            <Pager
              offset="state.offset"
              limit="state.limit"
              total="state.total"
              onUpdate.bind="onPageChange"
              class="'justify-content-center'"
            />
          </div>
        </div>
        <div class="row mb-3 justify-content-end">
          <div class="col-md-3">
            <Dropdown class="'w-100'" togglerClass="'btn btn-light'">
              <t t-set-slot="toggler">
                <i class="me-1 fa fa-filter" />
                <span class="o_dropdown_title">
                  Categories
                </span>
              </t>
              <span
                class="dropdown-item o_menu_item"
                t-on-click="() => this.onAllSubcategorySelect()"
                tabindex="0"
                aria-checked="false"
              >
                View all templates
              </span>
              <div role="separator" class="dropdown-divider" />
              <t t-foreach="state.categories" t-as="category" t-key="category.id">
                <Dropdown t-props="dropdownProps">
                  <t t-set-slot="toggler">
                    <t t-out="category.name" />
                  </t>
                  <t t-foreach="state.subcategories[category.categoryId]" t-as="subcat" t-key="subcat.id">
                    <div class="dropdown-item o_menu_item" t-on-click="() => this.onSubcategorySelect(subcat)">
                      <span t-esc="subcat.name" />
                    </div>
                  </t>
                </Dropdown>
              </t>
            </Dropdown>
          </div>
          <div class="col-md-3">
            <Dropdown class="'w-100'" togglerClass="'btn btn-light'">
              <t t-set-slot="toggler">
                <i class="me-1 fa fa-language" />
                <span>
                  Language
                </span>
              </t>
              <t t-foreach="state.locales" t-as="locale" t-key="locale.code">
                <DropdownItem onSelected="() => this.onLocaleChange(locale)">
                  <t t-esc="locale.name" />
                </DropdownItem>
              </t>
            </Dropdown>
          </div>
          <div class="col-md-6">
            <div class="o_searchview h-100" role="search" aria-autocomplete="list">
              <i class="o_searchview_icon oi oi-search p-2" role="img" aria-label="Search..." title="Search..." />
              <div class="o_searchview_input_container h-100">
                <input
                  type="text"
                  class="o_searchview_input"
                  placeholder="Search..."
                  role="searchbox"
                  data-hotkey="Q"
                  t-att-value="state.search"
                  t-on-input="(ev) => this.onSearch(ev.target.value)"
                />
              </div>
            </div>
          </div>
        </div>

        <t t-if="state.loading">
          <div class="text-center py-5">
            <i class="fa fa-refresh fa-spin fa-3x" />
            <p>Loading forms...</p>
          </div>
        </t>

        <t t-if="state.error">
          <div class="alert alert-danger" t-esc="state.error" />
        </t>

        <div class="row w-auto" t-if="!state.loading and !state.error">
          <t t-foreach="state.forms" t-as="form" t-key="form.id">
            <div class="col-md-3 mb-3 o_content">
              <div class="o_documents_kanban_view">
                <div
                  class="card h-100 o_kanban_record w-auto"
                  t-attf-class="{{ state.form and form.id == state.form.id ? 'o_record_selected' : '' }}"
                >
                  <div
                    class="card-img-top-container o_kanban_attachment"
                    style="height: 200px; overflow: hidden; cursor:zoom-in;"
                  >
                    <div>
                      <i
                        class="fa fa-circle-thin o_record_selector"
                        title="Select document"
                        style="cursor:pointer;"
                        t-on-click="() => this.selectForm(form)"
                      />
                    </div>
                    <div>
                      <img
                        t-att-src="getPreviewUrl(form) || getImageUrl(form) || '/web/static/img/placeholder.png'"
                        class="card-img-top"
                        style="object-fit: contain; height: 100%; width: 100%;"
                        t-att-alt="form.attributes.name_form"
                        t-on-click="() => this.previewForm(form.attributes.file_oform.data[0].attributes.url)"
                      />
                    </div>
                  </div>
                  <div class="card-footer bg-transparent d-flex justify-content-between" style="column-gap: 10px;">
                    <div>
                      <h5 class="card-title" t-esc="form.attributes.name_form" />
                    </div>
                    <div>
                      <i class="fa fa-info-circle" t-attf-data-tooltip="{{form.attributes.description_card}}" />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </div>

        <t t-if="!state.loading and !state.error and state.forms.length === 0">
          <div class="text-center py-5">
            <i class="fa fa-file-text-o fa-4x text-muted" />
            <h4 class="mt-3">No forms found</h4>
            <p class="text-muted">Try changing your search or filters</p>
          </div>
        </t>
      </div>

      <t t-set-slot="footer">
        <t t-if="state.form">
          <button class="btn btn-primary" t-on-click="download">Create</button>
        </t>
        <button class="btn btn-secondary" t-on-click="props.close">Back</button>
      </t>
    </Dialog>
  </t>
</templates>
