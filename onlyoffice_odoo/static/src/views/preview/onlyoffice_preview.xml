<templates xml:space="preserve">
  <t t-name="onlyoffice_odoo.OnlyofficePreview" owl="1">
    <div class="o-onlyoffice-preview w-100 h-100 bg-black-75" t-on-click="(ev) => this.onClickOutside(ev)">
      <div class="o-onlyoffice-preview-header d-flex w-75 mt-5 bg-black-75 text-400">
        <div class="o-onlyoffice-header-title d-flex align-items-center px-3">
          <i role="img" class="oi" data-icon="description" />
          <div class="text-400" t-esc="this.title" />
        </div>
        <div class="d-flex align-items-center h-100 px-3 cursor-pointer" t-on-click="() => this.props.close()">
          <i role="img" class="oi oi-fw" data-icon="close" />
        </div>
      </div>
      <div class="o-onlyoffice-preview-body d-flex w-75 h-100 mb-5 bg-black-75">
        <iframe t-att-src="this.url" class="o-onlyoffice-body-iframe" />
      </div>
    </div>
  </t>
</templates>
