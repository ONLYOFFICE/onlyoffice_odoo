<templates xml:space="preserve">
    <t t-inherit="mail.AttachmentList" t-inherit-mode="extension" owl="1">
    <xpath expr="//div[hasclass('o-mail-AttachmentButtons')]" position="inside">
      <button
        t-if="this.onlyofficeCanOpen(attachment)"
        t-on-click.stop="() => this.openOnlyoffice(attachment)"
        class="btn btn-secondary"
        title="Open in ONLYOFFICE"
      >
        <img src="/onlyoffice_odoo/static/svg/edit.svg" role="img" width="16" height="16" />
      </button>
    </xpath>
  </t>
</templates>
