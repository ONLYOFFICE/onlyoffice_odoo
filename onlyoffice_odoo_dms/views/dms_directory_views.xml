<odoo>
  <!-- Extend dms.directory form view -->
  <record id="view_dms_directory_form_onlyoffice_groups" model="ir.ui.view">
    <field name="name">dms_directory.form.onlyoffice.groups</field>
    <field name="model">dms.directory</field>
    <field name="inherit_id" ref="dms.view_dms_directory_form" />
    <field name="arch" type="xml">
      <!-- Groups tab: add ONLYOFFICE Role column -->
      <xpath expr="//field[@name='group_ids']//field[@name='perm_unlink']" position="after">
        <field
          name="oo_role"
          string="ONLYOFFICE Role"
          widget="dynamic_dropdown"
          options="{'values': 'oo_role_dynamic_values'}"
          context="{'depending_on': perm_write}"
          required="1"
        />
      </xpath>

      <!-- Complete Groups tab: add ONLYOFFICE Role column (read-only) -->
      <xpath expr="//field[@name='complete_group_ids']//field[@name='perm_unlink']" position="after">
        <field name="oo_role" string="ONLYOFFICE Role" readonly="1" />
      </xpath>

      <!-- Access Information tab: public link access -->
      <xpath expr="//page[@name='page_access']/group[@name='permissions']" position="after">
        <group string="ONLYOFFICE Access">
          <field name="oo_link_access" />
        </group>
      </xpath>
    </field>
  </record>
</odoo>
