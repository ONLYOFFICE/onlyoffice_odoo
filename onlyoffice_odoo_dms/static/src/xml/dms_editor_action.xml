<templates xml:space="preserve">

    <t t-name="onlyoffice_odoo_dms.EditorAction">
    <div class="o_onlyoffice_dms_action">
      <!-- Mirror exact Odoo 17 o_control_panel structure -->
      <div class="o_control_panel d-flex flex-column gap-3 px-3 pt-2 pb-3">
        <div
          class="o_control_panel_main d-flex flex-wrap flex-lg-nowrap justify-content-between align-items-lg-start gap-2 gap-lg-3 flex-grow-1"
        >
          <div class="o_control_panel_breadcrumbs d-flex align-items-center gap-1 order-0 h-lg-100">
            <div class="o_breadcrumb d-flex flex-row flex-md-column align-self-stretch justify-content-between min-w-0">
              <ol class="breadcrumb flex-nowrap text-nowrap lh-sm">
                <t t-foreach="parentBreadcrumbs" t-as="bc" t-key="bc.jsId">
                  <li class="breadcrumb-item d-inline-flex min-w-0 o_back_button">
                    <a
                      role="button"
                      class="fw-bold text-truncate"
                      t-on-click="() => navigateTo(bc.jsId)"
                      t-esc="bc.name"
                    />
                  </li>
                </t>
              </ol>
              <div class="d-flex gap-1 text-truncate" t-esc="currentBreadcrumb" />
            </div>
          </div>
        </div>
      </div>
      <iframe class="o_onlyoffice_dms_editor" t-att-src="editorUrl" allowfullscreen="true" />
    </div>
  </t>

</templates>
