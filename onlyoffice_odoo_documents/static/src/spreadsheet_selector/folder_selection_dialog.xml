<templates xml:space="preserve">
    <t t-name="onlyoffice_odoo_documents.FolderSelectionDialog" owl="1">
    <Dialog title="this.dialogTitle" contentClass="'o-onlyoffice-blank-spreadsheet-dialog'" footer="true">
      <div class="o_wrap_field d-flex flex-column mb-3">
        <label class="o_form_label" for="onlyoffice_blank_name">File name</label>
        <div class="o_field_widget o_field_char">
          <input
            class="o_input"
            id="onlyoffice_blank_name"
            type="text"
            autocomplete="off"
            t-model.proxy="this.state.name"
          />
        </div>
      </div>
      <div t-if="this.state.isLoading" class="text-center p-4">
        <i class="oi oi-spin oi-2x" data-icon="autorenew" />
      </div>
      <div t-elif="!this.state.folders.length" class="text-center p-4 text-muted">
        No available workspaces found.
      </div>
      <div t-else="" class="o-onlyoffice-folder-list">
        <t t-foreach="this.state.folders" t-as="folder" t-key="folder.id">
          <div
            class="o-onlyoffice-folder-item d-flex align-items-center p-2 border-bottom cursor-pointer"
            t-att-class="this.isSelected(folder.id) ? 'o-onlyoffice-folder-selected' : ''"
            t-on-click="() => this.selectFolder(folder.id)"
            t-on-dblclick="this.onConfirm"
          >
            <i class="oi me-2 text-warning" data-icon="folder" />
            <span t-esc="folder.display_name" />
          </div>
        </t>
      </div>
      <t t-set-slot="footer">
        <button class="btn btn-primary" t-att-disabled="this.isConfirmDisabled()" t-on-click="this.onConfirm">
          Create
        </button>
        <button class="btn btn-secondary" t-on-click="this.data.close">
          Cancel
        </button>
      </t>
    </Dialog>
  </t>
</templates>
