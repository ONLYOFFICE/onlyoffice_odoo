<templates>
  <t
    t-name="onlyoffice_odoo_documents.DocumentsViews.ControlPanel"
    t-inherit="documents.DocumentsViews.ControlPanel"
    t-inherit-mode="extension"
  >
    <xpath expr="//ul" position="inside">
      <button
        type="button"
        t-attf-class="btn btn-link dropdown-item o_documents_kanban_onlyoffice_odoo_documents {{additionalClasses}}"
        t-att-disabled="!folder.id"
        t-on-click.stop.prevent="onClickCreateOnlyoffice"
      >
        Create with ONLYOFFICE
      </button>
      <button
        type="button"
        t-attf-class="btn btn-link dropdown-item o_documents_kanban_onlyoffice_odoo_documents {{additionalClasses}}"
        t-on-click.stop.prevent="() => this.onClickAdvancedShare()"
      >
        Advanced Share
      </button>
      <button
        type="button"
        t-attf-class="btn btn-link dropdown-item o_documents_kanban_onlyoffice_odoo_documents {{additionalClasses}}"
        t-on-click.stop.prevent="() => this.onClickConvert()"
      >
        Convert with ONLYOFFICE
      </button>
    </xpath>
  </t>
</templates>
