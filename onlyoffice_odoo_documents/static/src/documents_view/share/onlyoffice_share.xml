<?xml version="1.0" encoding="UTF-8" ?>
<templates>
  <t t-name="onlyoffice_odoo_documents.ShareDialog" owl="1">
    <div class="o_onlyoffice_advanced_share">
      <t t-if="!state.loading">
        <Dialog title="'Advanced Share'" onClosed="() => this.props.close()">
          <div class="o_view_controller o_form_view">
            <div class="o_form_view_container">
              <div class="o_content">
                <div class="o_form_editable d-flex flex-nowrap h-100 o_form_dirty">
                  <div class="o_form_sheet_bg ">
                    <div class="o_form_sheet position-relative clearfix">
                      <div class="o_inner_group grid">
                        <div class="o_wrap_field d-flex d-sm-contents flex-column mb-3 mb-sm-0">
                          <div class="o_wrap_field d-flex d-sm-contents flex-column mb-3 mb-sm-0">
                            <div class="o_cell o_wrap_label flex-grow-1 flex-sm-grow-0 w-100 text-break text-900">
                              <label class="o_form_label o_form_label_readonly">
                                Shared Document
                              </label>
                            </div>
                            <div>
                              <span
                                tabindex="-1"
                                class="o_tag_color_0 badge rounded-pill o_tag d-inline-flex align-items-center mw-100"
                                t-att-title="state.document.text"
                              >
                                <div class="o_tag_badge_text">
                                  <t t-esc="state.document.text" />
                                </div>
                              </span>
                            </div>
                          </div>
                        </div>
                        <div class="o_wrap_field d-flex d-sm-contents flex-column mb-3 mb-sm-0">
                          <div class="o_cell o_wrap_label flex-grow-1 flex-sm-grow-0 w-100 text-break text-900">
                            <label class="o_form_label" for="user_ids">Add people</label>
                          </div>
                          <div class="o_cell o_wrap_input flex-grow-1 flex-sm-grow-0 text-break">
                            <div name="user_ids" class="o_field_widget o_field_many2many_tags">
                              <div class="o_field_tags d-inline-flex flex-wrap o_tags_input o_input">
                                <TagsList tags="tags" />
                                <Many2XAutocomplete
                                  placeholder="'Add people...'"
                                  resModel="'res.users'"
                                  value="state.usersInput"
                                  update.bind="onAddUsers"
                                  options="{'no_create': True}"
                                  activeActions="{create: false, create_edit: false}"
                                  getDomain.bind="getDomain"
                                />
                              </div>
                            </div>
                          </div>
                        </div>
                        <t t-if="state.users.length">
                          <div class="o_wrap_field d-flex d-sm-contents flex-column mb-3 mb-sm-0">
                            <div class="o_cell o_wrap_label flex-grow-1 flex-sm-grow-0 w-100 text-break text-900">
                              <label class="o_form_label" for="users_access_roles">User Access</label>
                            </div>
                            <div class="o_cell o_wrap_input flex-grow-1 flex-sm-grow-0 text-break">
                              <div name="users_access_roles" class="o_field_widget o_field_filtered_selection">
                                <select
                                  class="o_input pe-3"
                                  id="users_access_roles"
                                  t-att-disabled="state.saving"
                                  t-on-change="(ev) => onUserRoleAdd(ev.target.value)"
                                >
                                  <t
                                    t-foreach="Object.entries(state.usersAccessRoles)"
                                    t-as="users_access_role"
                                    t-key="users_access_role[0]"
                                  >
                                    <option
                                      t-att-value="users_access_role[0]"
                                      t-esc="users_access_role[1]"
                                      t-att-selected="users_access_role[0] == state.newUserAccess"
                                    />
                                  </t>
                                </select>
                              </div>
                            </div>
                          </div>
                        </t>
                      </div>

                      <t t-if="state.usersAccess.length">
                        <div class="mb-2">
                          <label class="o_form_label fw-bolder">
                            People with access
                          </label>
                          <div class="o_onlyoffice_users_access_list">
                            <t t-foreach="state.usersAccess" t-as="user" t-key="user.user.id">
                              <div class="row m-0 pe-3 py-1 pt-2">
                                <div class="col-sm-8 ps-0 pe-1 d-flex">
                                  <div class="pe-3">
                                    <img
                                      t-attf-src="/web/image?model=res.partner&amp;field=avatar_128&amp;id={{ user.user.id }}"
                                      class="o_image_40_cover rounded"
                                    />
                                  </div>
                                  <div>
                                    <div class="text-truncate fw-bolder">
                                      <t t-esc="user.user.name" />
                                    </div>
                                    <t t-if="user.user.email">
                                      <div class="text-truncate">
                                        <t t-esc="user.user.email" />
                                      </div>
                                    </t>
                                  </div>
                                </div>
                                <div class="col-sm-4 pe-0 align-content-center">
                                  <div class="input-group d-flex justify-content-end">
                                    <div class="w-50 pe-3 d-flex">
                                      <select
                                        class="o_input"
                                        t-att-disabled="state.saving"
                                        t-on-change="(ev) => onUserRoleChange(user.user.id, ev.target.value)"
                                      >
                                        <t
                                          t-foreach="Object.entries(state.usersAccessRoles)"
                                          t-as="users_access_role"
                                          t-key="users_access_role[0]"
                                        >
                                          <option
                                            t-att-value="users_access_role[0]"
                                            t-esc="users_access_role[1]"
                                            t-att-selected="users_access_role[0] == user.role.role"
                                          />
                                        </t>
                                      </select>
                                    </div>
                                    <button
                                      class="btn"
                                      title="Remove access"
                                      t-on-click="() => removeUserAccess(user.user.id)"
                                    >
                                      <i class="fa fa-archive" />
                                    </button>
                                  </div>
                                </div>
                              </div>
                            </t>
                          </div>
                        </div>
                      </t>

                      <div class="o_inner_group grid">
                        <div class="o_wrap_field d-flex d-sm-contents flex-column mb-3 mb-sm-0">
                          <div class="o_cell o_wrap_label flex-grow-1 flex-sm-grow-0 w-100 text-break text-900">
                            <label class="o_form_label fw-bolder mb-2">General access</label>
                          </div>
                          <div class="o_cell o_wrap_input flex-grow-1 flex-sm-grow-0 text-break" />
                        </div>
                        <div class="o_wrap_field d-flex d-sm-contents flex-column mb-3 mb-sm-0">
                          <div class="o_cell o_wrap_label flex-grow-1 flex-sm-grow-0 w-100 text-break text-900">
                            <label class="o_form_label" for="internal_users_roles">Internal Users</label>
                          </div>
                          <div class="o_cell o_wrap_input flex-grow-1 flex-sm-grow-0 text-break">
                            <div name="internal_users_roles" class="o_field_widget o_field_filtered_selection">
                              <select
                                class="o_input pe-3"
                                id="internal_users_roles"
                                t-att-disabled="state.saving"
                                t-on-change="onInternalAccessChange"
                              >
                                <t
                                  t-foreach="Object.entries(state.internalAccessRoles)"
                                  t-as="internal_users_role"
                                  t-key="internal_users_role[0]"
                                >
                                  <option
                                    t-att-value="internal_users_role[0]"
                                    t-esc="internal_users_role[1]"
                                    t-att-selected="internal_users_role[0] == state.internalAccess"
                                  />
                                </t>
                              </select>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <t t-set-slot="footer">
            <div class="d-flex justify-content-between w-100">
              <div>
                <t t-if="state.hasChanges">
                  <button class="btn btn-primary ms-2" t-att-disabled="state.saving" t-on-click="save">
                    Save
                  </button>
                </t>
                <t t-else="">
                  <button
                    class="btn btn-primary ms-2"
                    t-att-disabled="state.saving"
                    t-on-click="() => this.props.close()"
                  >
                    Done
                  </button>
                </t>
                <button class="btn btn-secondary" t-att-disabled="state.saving" t-on-click="() => this.props.close()">
                  Cancel
                </button>
              </div>
              <div class="ms-auto">
                <button t-if="state.hasChanges" class="btn btn-secondary" t-on-click="resetChanges">
                  <i class="fa fa-undo me-2" /> Reset Changes </button>
              </div>
            </div>
          </t>
        </Dialog>
      </t>
    </div>
  </t>
</templates>
