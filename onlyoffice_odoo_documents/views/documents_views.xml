<odoo>
  <!-- The inspector shows "Freeze and share" from the data of the selected records. -->
  <record id="document_view_kanban_onlyoffice" model="ir.ui.view">
    <field name="name">documents.document kanban onlyoffice</field>
    <field name="model">documents.document</field>
    <field name="inherit_id" ref="documents.document_view_kanban" />
    <field name="arch" type="xml">
      <field name="checksum" position="after">
        <field name="onlyoffice_can_freeze" />
      </field>
    </field>
  </record>

  <record id="documents_view_list_onlyoffice" model="ir.ui.view">
    <field name="name">documents list onlyoffice</field>
    <field name="model">documents.document</field>
    <field name="inherit_id" ref="documents.documents_view_list" />
    <field name="arch" type="xml">
      <field name="checksum" position="after">
        <field name="onlyoffice_can_freeze" column_invisible="True" />
      </field>
    </field>
  </record>
</odoo>
